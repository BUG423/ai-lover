{
  "name": "ai-lover",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docs:gallery": "node scripts/build-readme-gallery.mjs",
    "format": "prettier --write src shared server tests scripts desktop public/*.js *.ts *.json .github/workflows/*.yml",
    "format:check": "prettier --check src shared server tests scripts desktop public/*.js *.ts *.json .github/workflows/*.yml",
    "desktop:prepare": "npm run build && node scripts/build-desktop.mjs",
    "desktop:start": "npm run desktop:prepare && electron desktop-build",
    "desktop:build": "npm run desktop:prepare && electron-builder --config desktop/builder.cjs --win --x64 --publish never && node scripts/scan-desktop.mjs artifacts/windows/win-unpacked/resources/app.asar",
    "desktop:smoke": "node scripts/smoke-desktop.mjs"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.0"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electron/asar": "4.1.2",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
