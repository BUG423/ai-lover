{
  "name": "ai-lover",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run windows:start",
    "typecheck": "tsc --noEmit",
    "build:ui": "npm run typecheck && vite build",
    "android:sync": "npm run build:ui && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs",
    "windows:prepare": "npm run build:ui && node scripts/build-windows.mjs",
    "windows:start": "npm run windows:prepare && electron .build/windows",
    "windows:build": "npm run windows:prepare && electron-builder --config apps/windows/builder.cjs --win --x64 --publish never && node scripts/scan-windows.mjs artifacts/windows/win-unpacked/resources/app.asar",
    "windows:smoke": "node scripts/smoke-windows.mjs",
    "test": "vitest run",
    "test:ui": "playwright test",
    "format": "prettier --write packages apps/windows tests scripts *.ts *.json .github/workflows/*.yml",
    "format:check": "prettier --check packages apps/windows tests scripts *.ts *.json .github/workflows/*.yml"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.0"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@electron/asar": "4.1.2",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
